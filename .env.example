# ChainLead — bring your own keys. Never put wallet private keys or seed phrases here.
CHAINLEAD_DB=chainlead.db
# REST auth: comma-separated tenant:key pairs (required for non-localhost binding)
CHAINLEAD_API_KEYS=acme:change-me-long-random-key
# Max budget (USD) an AI agent may assign to a campaign through MCP
CHAINLEAD_AGENT_MAX_BUDGET_USD=1.0
# Optional data sources
GITHUB_TOKEN=
CHAINLEAD_RPC_8453=
CHAINLEAD_RPC_1=
EXPLORER_API_KEY=
GRAPH_API_KEY=
CHAINLEAD_CACHE_TTL=86400
CHAINLEAD_HTTP_TIMEOUT=15
