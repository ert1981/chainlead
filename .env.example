# ChainLead — bring your own keys. Never put wallet private keys or seed phrases here.
CHAINLEAD_DB=chainlead.db
# REST auth: comma-separated tenant:key pairs (required for non-localhost binding)
CHAINLEAD_API_KEYS=acme:change-me-long-random-key
# Max budget (USD) an AI agent may assign to a campaign through MCP
CHAINLEAD_AGENT_MAX_BUDGET_USD=1.0
# REST rate limits per tenant / client IP (per minute)
CHAINLEAD_RATE_LIMIT_PER_MIN=120
CHAINLEAD_RUN_LIMIT_PER_MIN=10
# Optional data sources
GITHUB_TOKEN=
CHAINLEAD_RPC_8453=
CHAINLEAD_RPC_1=
EXPLORER_API_KEY=
GRAPH_API_KEY=
CHAINLEAD_CACHE_TTL=86400
CHAINLEAD_HTTP_TIMEOUT=15

# ---- Paid x402 tool (chainlead tool-serve) — public values only, no secret is needed to get paid
CHAINLEAD_PUBLIC_BASE_URL=https://your-service.onrender.com
CHAINLEAD_PAYEE_ADDRESS=0xYourWallet
CHAINLEAD_CREATOR_ADDRESS=0xyourwallet
CHAINLEAD_PRICE_USDC=0.50
CHAINLEAD_X402_NETWORK=base
# CHAINLEAD_FACILITATOR_URL=https://facilitator.payai.network
CHAINLEAD_TOOL_TIME_BUDGET_S=35
CHAINLEAD_TOOL_MAX_CANDIDATES=8
CHAINLEAD_TOOL_MAX_CONCURRENT=2
